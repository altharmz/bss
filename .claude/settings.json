{
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(docker compose:*)",
      "Bash(docker build:*)",
      "Bash(docker images:*)",
      "Bash(docker inspect:*)",
      "Bash(./scripts/smoke.sh:*)",
      "Bash(./scripts/deploy.sh)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(rg:*)",
      "Bash(curl -fsS http://localhost:*)",
      "Read(./app/**)",
      "Read(./tests/**)",
      "Edit(./app/**)",
      "Edit(./tests/**)",
      "Read(./frontend/**)",
      "Edit(./frontend/**)",
      "Read(./design-ref/**)"
    ],
    "ask": [
      "Edit(./.claude/**)",
      "Edit(./compose.override.yaml)",
      "Edit(./compose.yaml)",
      "Edit(./compose.prod.yaml)",
      "Edit(./Makefile)",
      "Edit(./scripts/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.prod)",
      "Read(./.env.smoke)",
      "Edit(./.env)",
      "Edit(./.env.prod)",
      "Edit(./.env.smoke)",
      "Bash(git push:*)",
      "Bash(docker system prune:*)",
      "Bash(docker volume rm:*)",
      "Bash(docker volume prune:*)",
      "Bash(docker network prune:*)",
      "Bash(docker builder prune:*)",
      "Bash(sudo:*)",
      "Bash(ssh vps-test sudo:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(pnpm:*)",
      "Bash(yarn:*)",
      "Bash(corepack:*)",
      "Edit(./design-ref/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/format.sh", "timeout": 60 }
        ]
      }
    ]
  }
}
