{
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(docker compose:*)",
      "Bash(docker build:*)",
      "Bash(docker images:*)",
      "Bash(docker inspect:*)",
      "Bash(./scripts/smoke.sh:*)",
      "Bash(./scripts/deploy.sh)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push)",
      "Bash(git push origin:*)",
      "Bash(git push -u origin:*)",
      "Bash(rg:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue create:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr list:*)",
      "Bash(gh project item-list:*)",
      "Bash(gh project item-edit:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue close:*)",
      "Bash(gh pr merge:*)",
      "Bash(curl -fsS http://localhost:*)",
      "Read(./app/**)",
      "Read(./tests/**)",
      "Edit(./app/**)",
      "Edit(./tests/**)",
      "Read(./frontend/**)",
      "Edit(./frontend/**)",
      "Read(./design-ref/**)",
      "Edit(./docs/progress/scope.yaml)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.prod)",
      "Read(./.env.smoke)",
      "Edit(./.env)",
      "Edit(./.env.prod)",
      "Edit(./.env.smoke)",
      "Bash(docker system prune:*)",
      "Bash(docker volume rm:*)",
      "Bash(docker volume prune:*)",
      "Bash(docker network prune:*)",
      "Bash(docker builder prune:*)",
      "Bash(sudo:*)",
      "Bash(ssh vps-test sudo:*)",
      "Bash(pnpm:*)",
      "Bash(yarn:*)",
      "Bash(corepack:*)",
      "Edit(./design-ref/**)",
      "Edit(./.deployed)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/cloud-setup.sh\"", "timeout": 600 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/format.sh", "timeout": 60 }
        ]
      }
    ]
  }
}
