# Copy to .env for local dev and to .env.prod for the VPS. Never commit either.
#
# Local dev uses all three to create and reach its own postgres container.
# On the VPS only POSTGRES_PASSWORD is read: it must be the password of the `bss`
# role in the shared postgres run by vps-infra (user and database are fixed to
# bss in compose.prod.yaml).
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app

# The MCP connector's OAuth login (docs/mcp.md): name:<hash>[,name:<hash>], names
# ^[a-z0-9][a-z0-9._-]{0,47}$ (the principal is mcp:<name>). A hash, typed in a prompt and
# never echoed:
#   docker compose run --rm --no-deps app python -m bss_mcp.passwords
# The format has no "$" (compose would interpolate it). Empty: nobody can sign in through
# OAuth; static API tokens still work.
MCP_USERS=

# The app authenticates every request (docs/decisions/users.md). Service credentials, sent
# as X-Bss-Service; two different values, each `openssl rand -hex 32`. Empty: the
# credential never authenticates (fine for local dev, required on the VPS).
# BSS_SERVICE_SECRET: the mcp service (passed to app and mcp).
# BSS_SMOKE_SECRET: the web smoke test, GET/HEAD only - the same value also goes into
# .env.smoke, which the workstation's deploy.sh reads.
BSS_SERVICE_SECRET=
BSS_SMOKE_SECRET=

# The web smoke test reads BSS_SMOKE_SECRET from a separate, local-only file .env.smoke
# (gitignored, never shipped - .env.prod IS copied to the VPS as ~/bss/.env); deploy.sh
# refuses to start without it. One line, the same value as above:
#
#   BSS_SMOKE_SECRET=<hex>
#
# Caddy asks for no login since vps-infra U11 (2026-10-19): no SMOKE_BASIC_AUTH any more.
# Never printed by the scripts.
