# Copy to .env for local dev and to .env.prod for the VPS. Never commit either.
#
# Local dev uses all three to create and reach its own postgres container.
# On the VPS only POSTGRES_PASSWORD is read: it must be the password of the `bss`
# role in the shared postgres run by vps-infra (user and database are fixed to
# bss in compose.prod.yaml).
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app

# The MCP connector's OAuth login (docs/mcp.md): name:<hash>[,name:<hash>], names
# ^[a-z0-9][a-z0-9._-]{0,47}$ (the principal is mcp:<name>). A hash, typed in a prompt and
# never echoed:
#   docker compose run --rm --no-deps app python -m bss_mcp.passwords
# The format has no "$" (compose would interpolate it). Empty: nobody can sign in through
# OAuth; static API tokens still work.
MCP_USERS=

# NOT here: the web smoke test's credential goes into a separate, local-only file
# .env.smoke (gitignored, never shipped - .env.prod IS copied to the VPS as ~/bss/.env).
# deploy.sh refuses to start without it, and refuses if .env.prod has this line. One line:
#
#   SMOKE_BASIC_AUTH=smoke:<password>
#
# The `smoke` user is GET-only in the shared Caddy (any other method 403) and has its own
# hash there (docs/vps-infra-change-request.md). Never printed by the scripts.
