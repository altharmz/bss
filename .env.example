# Copy to .env for local dev and to .env.prod for the VPS. Never commit either.
#
# Local dev uses all three to create and reach its own postgres container.
# On the VPS only POSTGRES_PASSWORD is read: it must be the password of the `bss`
# role in the shared postgres run by vps-infra (user and database are fixed to
# bss in compose.prod.yaml).
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app

# .env.prod only, read by scripts/deploy.sh on the workstation for the web smoke test:
# basic-auth credentials through the shared Caddy, as user:password. (deploy.sh copies
# the whole .env.prod to the VPS as .env, so the value is there too; nothing reads it.)
# The `smoke` user is GET-only in Caddy (any other method 403) and has its own hash
# there (docs/vps-infra-change-request.md). Never printed by the scripts.
SMOKE_BASIC_AUTH=smoke:change-me
