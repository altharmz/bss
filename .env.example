# Copy to .env for local dev and to .env.prod for the VPS. Never commit either.
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app

# .env.prod only, ignored by local dev. true only for the first service of this kind set
# up on a given VPS: deploy.sh then starts this stack's own Caddy container. Every
# later service on the same VPS sets this to false and instead adds its own block to the
# Caddy that's already running there - see README.md for both scenarios and the block to
# copy. Leaving this true for a second service starts a second Caddy fighting the first
# one for ports 80/__HTTPS_PORT__.
WITH_CADDY=false
