.env
.env.prod
.env.smoke
# Non-secret identity and explicit ports, local to each task worktree.
.task/
# make deploy: the last deployed commit; written only by scripts/deploy.sh
.deployed
.deployed.tmp
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.venv/
*.tar.gz
backups/
# make progress: local collectors' JSON and generated reports (not committed)
.progress/
# make docs: the collector's JSON (the generated docs/api/ and docs/db/ are committed)
.docs/
# Ephemeral local browser-test credentials; removed after the test run.
frontend/.e2e/

frontend/.shots/
# make test-changed: pytest-testmon's data (which test ran which code)
.testmon/
loadtest/out/
